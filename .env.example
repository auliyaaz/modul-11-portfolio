# ============================================================
# PANDUAN SETUP DATABASE
# ============================================================
# 1. Salin file ini dan beri nama .env.local
#    (di Windows: klik kanan → Rename, atau pakai terminal)
#
# 2. Isi DATABASE_URL dengan connection string dari Neon.tech:
#    - Buka https://console.neon.tech
#    - Pilih project Anda → Connection Details
#    - Salin "Connection string" dan tempelkan di bawah
#
# 3. Jalankan: npx prisma db push
#    untuk membuat tabel di database Anda
# ============================================================

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
